{
  "$comment": "Neutral defaults. A project overrides what it needs in design/theme.json.",
  "color": {
    "ink": "#14161a",
    "ink-muted": "#5b6068",
    "paper": "#f7f5ef",
    "surface": "#ffffff",
    "hairline": "rgba(20, 22, 26, 0.12)",
    "action": "#0b6b3a",
    "action-ink": "#ffffff",
    "alert": "#a15c00",
    "danger": "#a4161a",
    "focus": "#1d4ed8"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "6px",
    "lg": "10px",
    "pill": "999px"
  },
  "type": {
    "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "mono": "ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, monospace",
    "size-xs": "0.6875rem",
    "size-sm": "0.8125rem",
    "size-md": "1rem",
    "size-lg": "1.25rem",
    "size-xl": "1.75rem",
    "size-2xl": "2.5rem",
    "leading-tight": "1.1",
    "leading-normal": "1.45",
    "tracking-label": "0.08em"
  },
  "motion": {
    "fast": "100ms",
    "base": "160ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "layout": {
    "max-width": "30rem",
    "inset": "1.25rem",
    "tap-min": "44px"
  }
}
